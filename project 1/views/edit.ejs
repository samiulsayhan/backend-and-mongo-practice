<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- <script src="/reload/reload.js"></script> -->

</head>

<body>
    <div class="main w-full min-h-screen text-white bg-gray-800 p-10">
        <a href="/" class="text-blue-600">go back to home</a>
        <!-- <h1 class="text-3xl mt-5 "><%= filename.slice(0, -4) %></h1> -->
        <form class="mt-5 text-white" action="/create" method="post">
            <input class="w-1/4 rounded-md block px-5 py-2 bg-gray-600 " type="text" placeholder="Current file name"
                name="title" value="<%= filename.slice(0, -4) %>">
            <textarea class="w-1/4 rounded-md mt-2  block resize-none px-5 py-2 bg-gray-600"
                placeholder="New file name " name="details"></textarea>
            <input class="mt-2 bg-orange-600 rounded-md px-5 py-2" type="submit" value="Update">
        </form>
    </div>
</body>

</html>