<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- <script src="/reload/reload.js"></script> -->

</head>

<body>
    <div class="main w-full min-h-screen bg-gray-800">
        <div class="form text-white p-10">
            <form class="" action="/create" method="post">
                <input class="w-full rounded-md block px-5 py-2 bg-gray-600 " type="text"
                    placeholder="Title goes here.." name="title">
                <textarea class="w-full rounded-md mt-2  block resize-none px-5 py-2 bg-gray-600"
                    placeholder="Title goes here.." name="details">
                </textarea>
                <input class="mt-2 bg-blue-400 rounded-md px-5 py-2" type="submit" value="Create Task">
            </form>
        </div>
        <div class="task p-10 gap-3 flex flex-wrap">

            <% if(files.length> 0){ %>
            <% files.forEach(function(val){ %>
                <div class="task min-w-72 px-3 py-4 rounded-md bg-gray-600">
                    <h1 class="text-white text-3xl tracking-tighter"><%= val %></h1>
                    <a class="text-blue-500 inline-block mt-3" href="/files/<%=  val %>">Read More</a>
                </div>
            <% }) %>
            <% } else {%>
                <h1 class="text-zinc-600">no tasks yet.</h1>
            <% } %>

        </div>
    </div>
</body>

</html>